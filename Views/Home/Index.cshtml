@model IEnumerable<AppleStoreWeb.Models.Product>
@{
    ViewData["Title"] = "Apple Store - Trang chủ";
}

@functions {
    public string GetProductSlug(string productName)
    {
        var slug = productName.ToLower().Replace(" ", "-");
        
        // Specific mappings
        if (slug.Contains("iphone-15-pro-max")) return "iphone-15-pro-max";
        if (slug.Contains("iphone-15-pro")) return "iphone-15-pro";
        if (slug.Contains("macbook")) return "macbook-air-m3";
        if (slug.Contains("ipad-pro")) return "ipad-pro";
        if (slug.Contains("airpods-pro")) return "airpods-pro";
        
        return slug;
    }
}

<!-- Hero Section -->
<section class="hero-banner text-center text-white mb-5">
    <div class="container">
        <div class="hero-content">
            <div class="apple-logo">
                <i class="fab fa-apple"></i>
            </div>
            <h1 class="display-3 fw-bold mb-4">Apple Store Vietnam</h1>
            <p class="lead mb-4">Khám phá thế giới công nghệ Apple với những sản phẩm chính hãng</p>
            <div class="row justify-content-center mb-4">
                <div class="col-md-8">
                    <div class="tech-specs">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="spec-item">
                                    <div class="spec-icon"><i class="fas fa-shield-alt"></i></div>
                                    <span>Chính hãng 100%</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="spec-item">
                                    <div class="spec-icon"><i class="fas fa-shipping-fast"></i></div>
                                    <span>Giao hàng nhanh</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="spec-item">
                                    <div class="spec-icon"><i class="fas fa-tools"></i></div>
                                    <span>Hỗ trợ 24/7</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <a href="#products" class="btn btn-light btn-lg px-5 py-3">Mua sắm ngay</a>
        </div>
    </div>
</section>

<!-- Featured Categories -->
<section class="categories-section mb-5">
    <div class="container">
        <h2 class="text-center mb-5">Danh mục sản phẩm</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <div class="category-icon iphone-icon mb-3">
                            <i class="fas fa-mobile-alt"></i>
                        </div>
                        <h5 class="card-title">iPhone</h5>
                        <p class="card-text">Dòng điện thoại thông minh hàng đầu từ Apple</p>
                        <a href="#" class="btn btn-outline-primary">Xem thêm</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <div class="category-icon macbook-icon mb-3">
                            <i class="fas fa-laptop"></i>
                        </div>
                        <h5 class="card-title">MacBook</h5>
                        <p class="card-text">Laptop cao cấp cho công việc và sáng tạo</p>
                        <a href="#" class="btn btn-outline-primary">Xem thêm</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <div class="category-icon ipad-icon mb-3">
                            <i class="fas fa-tablet-alt"></i>
                        </div>
                        <h5 class="card-title">iPad</h5>
                        <p class="card-text">Máy tính bảng đa năng cho mọi nhu cầu</p>
                        <a href="#" class="btn btn-outline-primary">Xem thêm</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Product Showcase -->
<section class="product-showcase mb-5">
    <div class="container">
        <div class="product-showcase-content">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h2 class="display-4 fw-bold mb-4">iPhone 15 Pro</h2>
                    <p class="lead mb-4">Titanium. Mạnh mẽ nhất từ trước đến nay. Nhẹ nhàng đến không ngờ. Pro đến từng chi tiết.</p>
                    <div class="mb-4">
                        <div class="spec-item mb-2">
                            <div class="spec-icon"><i class="fas fa-microchip"></i></div>
                            <span>Chip A17 Pro với GPU 6 nhân</span>
                        </div>
                        <div class="spec-item mb-2">
                            <div class="spec-icon"><i class="fas fa-camera"></i></div>
                            <span>Hệ thống camera Pro 48MP</span>
                        </div>
                        <div class="spec-item mb-2">
                            <div class="spec-icon"><i class="fas fa-battery-full"></i></div>
                            <span>Pin sử dụng lên đến 29 giờ</span>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <button class="btn btn-primary btn-lg">Mua ngay - 29.999.000₫</button>
                        <button class="btn btn-outline-primary btn-lg">Tìm hiểu thêm</button>
                    </div>
                </div>
                <div class="col-lg-6 text-center">
                    <div class="product-image iphone-15-pro" style="height: 400px; max-width: 300px; margin: 0 auto;"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Products -->
<section id="products" class="products-section mb-5">
    <div class="container">
        <h2 class="text-center mb-5">Sản phẩm nổi bật</h2>
        <div class="row g-4">
            @foreach (var product in Model)
            {
                <div class="col-lg-3 col-md-6">
                    <div class="card product-card h-100 shadow-sm border-0">
                        <div class="position-relative">
                            <div class="product-image" data-product="@GetProductSlug(product.Name)" style="height: 250px;"></div>
                            @if (product.OriginalPrice.HasValue && product.OriginalPrice > product.Price)
                            {
                                <span class="badge bg-danger position-absolute top-0 end-0 m-2">
                                    -@Math.Round((product.OriginalPrice.Value - product.Price) / product.OriginalPrice.Value * 100)%
                                </span>
                            }
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@product.Name</h5>
                            <p class="card-text text-muted flex-grow-1">@product.Description</p>
                            
                            @if (!string.IsNullOrEmpty(product.Color))
                            {
                                <p class="text-muted mb-1"><small>Màu: @product.Color</small></p>
                            }
                            @if (!string.IsNullOrEmpty(product.Storage))
                            {
                                <p class="text-muted mb-2"><small>Dung lượng: @product.Storage</small></p>
                            }

                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <div>
                                    <span class="h5 text-primary mb-0">@product.Price.ToString("N0")₫</span>
                                    @if (product.OriginalPrice.HasValue && product.OriginalPrice > product.Price)
                                    {
                                        <br><small class="text-muted text-decoration-line-through">@product.OriginalPrice.Value.ToString("N0")₫</small>
                                    }
                                </div>
                                <div>
                                    <a href="@Url.Action("Details", "Products", new { id = product.Id })" class="btn btn-outline-primary btn-sm me-1">Chi tiết</a>
                                    @if (User.Identity.IsAuthenticated)
                                    {
                                        <button class="btn btn-primary btn-sm add-to-cart" data-product-id="@product.Id">
                                            <i class="fas fa-shopping-cart"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <div class="text-center mt-4">
            <a href="@Url.Action("Index", "Products")" class="btn btn-outline-primary btn-lg">
                Xem tất cả sản phẩm <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>

<!-- Why Choose Us -->
<section class="why-choose-us py-5" style="background-color: #f8f9fa;">
    <div class="container">
        <h2 class="text-center mb-5">Tại sao chọn chúng tôi?</h2>
        <div class="row g-4">
            <div class="col-md-4 text-center">
                <div class="mb-3">
                    <i class="fas fa-shield-alt fa-3x text-success"></i>
                </div>
                <h5>Chính hãng 100%</h5>
                <p>Tất cả sản phẩm đều chính hãng Apple với đầy đủ tem bảo hành</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="mb-3">
                    <i class="fas fa-shipping-fast fa-3x text-info"></i>
                </div>
                <h5>Giao hàng nhanh</h5>
                <p>Giao hàng miễn phí toàn quốc trong 24h với đơn hàng trên 5 triệu</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="mb-3">
                    <i class="fas fa-tools fa-3x text-warning"></i>
                </div>
                <h5>Hỗ trợ kỹ thuật</h5>
                <p>Đội ngũ kỹ thuật chuyên nghiệp hỗ trợ 24/7</p>
            </div>
        </div>
    </div>
</section>
