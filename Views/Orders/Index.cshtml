@model IEnumerable<AppleStoreWeb.Models.Order>

@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<div class="container mt-4">
    <h2 class="mb-4">Đơn hàng của tôi</h2>

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var order in Model)
            {
                <div class="col-12 mb-3">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0">Đơn hàng #@order.Id</h6>
                                <small class="text-muted">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                            <div>
                                @switch (order.Status)
                                {
                                    case OrderStatus.Pending:
                                        <span class="badge bg-warning">Chờ xử lý</span>
                                        break;
                                    case OrderStatus.Confirmed:
                                        <span class="badge bg-info">Đã xác nhận</span>
                                        break;
                                    case OrderStatus.Processing:
                                        <span class="badge bg-primary">Đang xử lý</span>
                                        break;
                                    case OrderStatus.Shipped:
                                        <span class="badge bg-secondary">Đang giao</span>
                                        break;
                                    case OrderStatus.Delivered:
                                        <span class="badge bg-success">Đã giao</span>
                                        break;
                                    case OrderStatus.Cancelled:
                                        <span class="badge bg-danger">Đã hủy</span>
                                        break;
                                }
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-8">
                                    <h6>Sản phẩm:</h6>
                                    @foreach (var item in order.OrderItems.Take(3))
                                    {
                                        <div class="d-flex align-items-center mb-2">
                                            <img src="@item.Product.ImageUrl" class="me-3 rounded" style="width: 50px; height: 50px; object-fit: cover;" alt="@item.Product.Name">
                                            <div>
                                                <div class="fw-bold">@item.Product.Name</div>
                                                <small class="text-muted">Số lượng: @item.Quantity</small>
                                            </div>
                                        </div>
                                    }
                                    @if (order.OrderItems.Count > 3)
                                    {
                                        <small class="text-muted">và @(order.OrderItems.Count - 3) sản phẩm khác...</small>
                                    }
                                </div>
                                <div class="col-md-4 text-end">
                                    <div class="mb-2">
                                        <strong class="text-primary">@order.TotalAmount.ToString("N0")₫</strong>
                                    </div>
                                    <div>
                                        <a href="@Url.Action("Details", new { id = order.Id })" class="btn btn-outline-primary btn-sm">
                                            <i class="fas fa-eye me-1"></i>Xem chi tiết
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-shopping-bag fa-3x text-muted mb-3"></i>
            <h4>Chưa có đơn hàng nào</h4>
            <p class="text-muted mb-4">Bạn chưa có đơn hàng nào. Hãy bắt đầu mua sắm ngay!</p>
            <a href="@Url.Action("Index", "Products")" class="btn btn-primary">
                <i class="fas fa-shopping-cart me-2"></i>Bắt đầu mua sắm
            </a>
        </div>
    }
</div>