@model AppleStoreWeb.Models.Order

@{
    ViewData["Title"] = $"Chi tiết đơn hàng #{Model.Id}";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Chi tiết đơn hàng #@Model.Id</h2>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5>Thông tin đơn hàng</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Mã đơn hàng:</strong></div>
                        <div class="col-sm-8">#@Model.Id</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Ngày đặt:</strong></div>
                        <div class="col-sm-8">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Trạng thái:</strong></div>
                        <div class="col-sm-8">
                            @switch (Model.Status)
                            {
                                case OrderStatus.Pending:
                                    <span class="badge bg-warning">Chờ xử lý</span>
                                    break;
                                case OrderStatus.Confirmed:
                                    <span class="badge bg-info">Đã xác nhận</span>
                                    break;
                                case OrderStatus.Processing:
                                    <span class="badge bg-primary">Đang xử lý</span>
                                    break;
                                case OrderStatus.Shipped:
                                    <span class="badge bg-secondary">Đang giao</span>
                                    break;
                                case OrderStatus.Delivered:
                                    <span class="badge bg-success">Đã giao</span>
                                    break;
                                case OrderStatus.Cancelled:
                                    <span class="badge bg-danger">Đã hủy</span>
                                    break;
                            }
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Tên khách hàng:</strong></div>
                        <div class="col-sm-8">@Model.CustomerName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Số điện thoại:</strong></div>
                        <div class="col-sm-8">@Model.PhoneNumber</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Địa chỉ giao hàng:</strong></div>
                        <div class="col-sm-8">@Model.ShippingAddress</div>
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    <h5>Sản phẩm đã đặt</h5>
                </div>
                <div class="card-body">
                    @foreach (var item in Model.OrderItems)
                    {
                        <div class="row align-items-center border-bottom py-3">
                            <div class="col-md-2">
                                <img src="@item.Product.ImageUrl" class="img-fluid rounded" alt="@item.Product.Name" style="height: 80px; object-fit: cover;">
                            </div>
                            <div class="col-md-5">
                                <h6 class="mb-1">@item.Product.Name</h6>
                                <small class="text-muted">@item.Product.Category.Name</small>
                                @if (!string.IsNullOrEmpty(item.Product.Color))
                                {
                                    <br><small class="text-muted">Màu: @item.Product.Color</small>
                                }
                                @if (!string.IsNullOrEmpty(item.Product.Storage))
                                {
                                    <br><small class="text-muted">Dung lượng: @item.Product.Storage</small>
                                }
                            </div>
                            <div class="col-md-2 text-center">
                                <span>@item.UnitPrice.ToString("N0")₫</span>
                            </div>
                            <div class="col-md-1 text-center">
                                <span>x@item.Quantity</span>
                            </div>
                            <div class="col-md-2 text-end">
                                <strong>@item.TotalPrice.ToString("N0")₫</strong>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Tóm tắt đơn hàng</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tạm tính:</span>
                        <span>@Model.TotalAmount.ToString("N0")₫</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Phí vận chuyển:</span>
                        <span class="text-success">Miễn phí</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-3">
                        <strong>Tổng cộng:</strong>
                        <strong class="text-primary">@Model.TotalAmount.ToString("N0")₫</strong>
                    </div>
                    
                    @if (Model.Status == OrderStatus.Pending || Model.Status == OrderStatus.Confirmed)
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            Đơn hàng đang được xử lý. Chúng tôi sẽ liên hệ với bạn sớm nhất.
                        </div>
                    }
                    else if (Model.Status == OrderStatus.Shipped)
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-truck me-2"></i>
                            Đơn hàng đang được giao đến bạn.
                        </div>
                    }
                    else if (Model.Status == OrderStatus.Delivered)
                    {
                        <div class="alert alert-success">
                            <i class="fas fa-check-circle me-2"></i>
                            Đơn hàng đã được giao thành công.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>