@model IEnumerable<AppleStoreWeb.Models.ApplicationUser>

@{
    ViewData["Title"] = "Quản lý khách hàng";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-users me-2"></i>Quản lý khách hàng</h2>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Dashboard
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Tên đầy đủ</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th>Ngày đăng ký</th>
                            <th>Đơn hàng</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@(user.FullName ?? "Chưa cập nhật")</strong>
                                    @if (user.Email == "admin@applestore.com")
                                    {
                                        <span class="badge bg-warning ms-1">Admin</span>
                                    }
                                </td>
                                <td>@user.Email</td>
                                <td>@(user.PhoneNumber ?? "Chưa cập nhật")</td>
                                <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @{
                                        var orderCount = user.Orders?.Count ?? 0;
                                    }
                                    <span class="badge @(orderCount > 0 ? "bg-success" : "bg-secondary")">
                                        @orderCount đơn hàng
                                    </span>
                                </td>
                                <td>
                                    @if (user.EmailConfirmed)
                                    {
                                        <span class="badge bg-success">Đã xác thực</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Chưa xác thực</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>