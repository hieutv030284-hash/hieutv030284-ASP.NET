@model IEnumerable<AppleStoreWeb.Models.Order>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-shopping-cart me-2"></i>Quản lý đơn hàng</h2>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Sản phẩm</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Ngày đặt</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td><strong>#@order.Id</strong></td>
                                <td>
                                    <div>
                                        <strong>@order.CustomerName</strong>
                                        <br><small class="text-muted">@order.PhoneNumber</small>
                                    </div>
                                </td>
                                <td>
                                    <small>@order.OrderItems.Count sản phẩm</small>
                                    @foreach (var item in order.OrderItems.Take(2))
                                    {
                                        <br><small class="text-muted">@item.Product.Name (x@item.Quantity)</small>
                                    }
                                    @if (order.OrderItems.Count > 2)
                                    {
                                        <br><small class="text-muted">và @(order.OrderItems.Count - 2) sản phẩm khác...</small>
                                    }
                                </td>
                                <td><strong class="text-primary">@order.TotalAmount.ToString("N0")₫</strong></td>
                                <td>
                                    <div class="dropdown">
                                        <button class="btn btn-sm dropdown-toggle @GetStatusBadgeClass(order.Status)" type="button" data-bs-toggle="dropdown">
                                            @GetStatusText(order.Status)
                                        </button>
                                        <ul class="dropdown-menu">
                                            @foreach (OrderStatus status in Enum.GetValues<OrderStatus>())
                                            {
                                                <li>
                                                    <form asp-action="UpdateOrderStatus" method="post" class="d-inline">
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <input type="hidden" name="status" value="@status" />
                                                        <button type="submit" class="dropdown-item @(order.Status == status ? "active" : "")">
                                                            @GetStatusText(status)
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                                <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <a href="@Url.Action("Details", "Orders", new { id = order.Id })" class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "btn-warning",
            OrderStatus.Confirmed => "btn-info",
            OrderStatus.Processing => "btn-primary",
            OrderStatus.Shipped => "btn-secondary",
            OrderStatus.Delivered => "btn-success",
            OrderStatus.Cancelled => "btn-danger",
            _ => "btn-secondary"
        };
    }

    public string GetStatusText(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "Chờ xử lý",
            OrderStatus.Confirmed => "Đã xác nhận",
            OrderStatus.Processing => "Đang xử lý",
            OrderStatus.Shipped => "Đang giao",
            OrderStatus.Delivered => "Đã giao",
            OrderStatus.Cancelled => "Đã hủy",
            _ => "Không xác định"
        };
    }
}