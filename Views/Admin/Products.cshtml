@model IEnumerable<AppleStoreWeb.Models.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-box me-2"></i>Quản lý sản phẩm</h2>
        <div>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary me-2">
                <i class="fas fa-arrow-left me-1"></i>Dashboard
            </a>
            <button class="btn btn-primary">
                <i class="fas fa-plus me-1"></i>Thêm sản phẩm
            </button>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Hình ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Danh mục</th>
                            <th>Giá</th>
                            <th>Kho</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@product.ImageUrl" class="rounded" style="width: 50px; height: 50px; object-fit: cover;" alt="@product.Name">
                                </td>
                                <td>
                                    <div>
                                        <strong>@product.Name</strong>
                                        @if (product.IsFeatured)
                                        {
                                            <span class="badge bg-warning ms-1">Nổi bật</span>
                                        }
                                    </div>
                                    <small class="text-muted">@product.Description?.Substring(0, Math.Min(50, product.Description.Length))...</small>
                                </td>
                                <td>@product.Category.Name</td>
                                <td>
                                    <strong class="text-primary">@product.Price.ToString("N0")₫</strong>
                                    @if (product.OriginalPrice.HasValue && product.OriginalPrice > product.Price)
                                    {
                                        <br><small class="text-muted text-decoration-line-through">@product.OriginalPrice.Value.ToString("N0")₫</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(product.Stock > 10 ? "bg-success" : product.Stock > 0 ? "bg-warning" : "bg-danger")">
                                        @product.Stock
                                    </span>
                                </td>
                                <td>
                                    @if (product.IsActive)
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Tạm dừng</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="@Url.Action("Details", "Products", new { id = product.Id })" class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-warning" title="Chỉnh sửa">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <form asp-action="ToggleProductStatus" method="post" class="d-inline">
                                            <input type="hidden" name="productId" value="@product.Id" />
                                            <button type="submit" class="btn btn-sm @(product.IsActive ? "btn-outline-secondary" : "btn-outline-success")" 
                                                    title="@(product.IsActive ? "Tạm dừng" : "Kích hoạt")"
                                                    onclick="return confirm('@(product.IsActive ? "Tạm dừng" : "Kích hoạt") sản phẩm này?')">
                                                <i class="fas @(product.IsActive ? "fa-pause" : "fa-play")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>